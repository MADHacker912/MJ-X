<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <!-- Primary Claymorphic Pill -->
    <LinearLayout
        android:id="@+id/overlayPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/clay_overlay_bubble">

        <TextView
            android:id="@+id/overlayIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textColor="#00F0FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlayLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" MJ-X Agent"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/overlayArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▾"
            android:textColor="#A855F7"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Expanded Claymorphic Action Menu -->
    <LinearLayout
        android:id="@+id/overlayExpandedMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:background="@drawable/clay_overlay_menu"
        android:visibility="gone">

        <Button
            android:id="@+id/btnOverlayVoice"
            android:layout_width="160dp"
            android:layout_height="40dp"
            android:text="🎙️ Voice Command"
            android:background="@drawable/clay_input_bg"
            android:textColor="#00F0FF"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnOverlayScan"
            android:layout_width="160dp"
            android:layout_height="40dp"
            android:text="👁️ Scan Screen"
            android:background="@drawable/clay_input_bg"
            android:textColor="#58A6FF"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnOverlayMute"
            android:layout_width="160dp"
            android:layout_height="40dp"
            android:text="🔇 Mute / Pause"
            android:background="@drawable/clay_input_bg"
            android:textColor="#E6EDF3"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnOverlayEnd"
            android:layout_width="160dp"
            android:layout_height="40dp"
            android:text="⏹️ Stop Current Task"
            android:background="@drawable/clay_input_bg"
            android:textColor="#F85149"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnOverlayHide"
            android:layout_width="160dp"
            android:layout_height="36dp"
            android:text="❌ Hide to Edge"
            android:background="@android:color/transparent"
            android:textColor="#8B949E"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
